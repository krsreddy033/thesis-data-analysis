    {
      "cell_type": "markdown",
      "source": [
        "**Average contact points for an rotation_2_df**"
      ],
      "metadata": {
        "id": "zyM_tuwwl7a3"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import plotly.express as px\n",
        "\n",
        "# --- ASSUMPTIONS:\n",
        "# rotation_2_df as the raw‐data slice between Drum3_end → Drum4_start.\n",
        "# Speed = alicon_2020_C_104_speed is defined.\n",
        "\n",
        "# Isolate only the idler contact moments (sum > 2) and compute time gaps\n",
        "df_idler = rotation_2_df[rotation_2_df['sum'] > 2].copy().reset_index(drop=True)\n",
        "df_idler['time_diff'] = df_idler['Time'].diff().fillna(0)\n",
        "\n",
        "# Derive the time threshold from 0.15 m interaction region\n",
        "time_threshold = 0.15 / Speed\n",
        "print(f\"Using time threshold = {time_threshold:.3f} s for splitting idler stations\")\n",
        "\n",
        "# Find breakpoints where belt moves more than threshold → new station\n",
        "idx_after  = df_idler[df_idler['time_diff'] > time_threshold].index\n",
        "idx_before = idx_after - 1\n",
        "\n",
        "# Build the edge timestamps (start/end) for each station contact\n",
        "df_edges = pd.concat([\n",
        "    df_idler.iloc[[0]],                               # start of Station 1\n",
        "    df_idler.loc[idx_before.tolist() + idx_after.tolist()].sort_index(),\n",
        "    df_idler.iloc[[-1]]                               # end of last station\n",
        "]).reset_index(drop=True)\n",
        "\n",
        "# Pair edges into station windows\n",
        "times = df_edges['Time'].values\n",
        "pairs = [(times[i], times[i+1]) for i in range(0, len(times)-1, 2)]\n",
        "station_windows = pd.DataFrame(pairs, columns=['start','end'])\n",
        "station_windows['IdlerStation'] = [\n",
        "    f'IdlerStation {i+1}' for i in range(len(pairs))\n",
        "]\n",
        "\n",
        "# Remove the first and last (drum‐noise) stations ---\n",
        "station_windows = station_windows.iloc[1:-1].reset_index(drop=True)\n",
        "station_windows['IdlerStation'] = [\n",
        "    f'IdlerStation {i+1}' for i in range(len(station_windows))\n",
        "]\n",
        "\n",
        "# For each station, compute & plot avg contact *distance* per sensor ---\n",
        "for _, row in station_windows.iterrows():\n",
        "    start, end, label = row['start'], row['end'], row['IdlerStation']\n",
        "\n",
        "    # slice raw data for this station window\n",
        "    block = rotation_2_df[(rotation_2_df['Time'] >= start) & (rotation_2_df['Time'] <= end)]\n",
        "\n",
        "    # compute per-sensor average Time and convert to distance\n",
        "    sensor_avgs = []\n",
        "    for i in range(12):\n",
        "        col = f\"Sensor_{i}\"\n",
        "        times_i = block.loc[block[col] == 1, 'Time']\n",
        "        if not times_i.empty:\n",
        "            avg_t = times_i.mean()\n",
        "            avg_d = avg_t * Speed\n",
        "        else:\n",
        "            avg_t = np.nan\n",
        "            avg_d = np.nan\n",
        "        sensor_avgs.append({'Sensor': i, 'AvgDistance': avg_d})\n",
        "    df_avgs = pd.DataFrame(sensor_avgs)\n",
        "\n",
        "    # plot sensor index (y) vs average contact distance (x)\n",
        "    fig = px.scatter(\n",
        "        df_avgs,\n",
        "        x='AvgDistance',\n",
        "        y='Sensor',\n",
        "        title=f\"{label}: Avg Contact Position per Sensor\",\n",
        "        labels={'AvgDistance':'Distance along Belt (m)', 'Sensor':'Sensor Index'},\n",
        "        height=400\n",
        "    )\n",
        "    fig.update_yaxes(tickmode='linear', dtick=1, autorange='reversed')\n",
        "    fig.show()\n"
      ],
