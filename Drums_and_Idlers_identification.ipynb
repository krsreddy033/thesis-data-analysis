      "cell_type": "markdown",
      "source": [
        "**Idlers visualisation**"
      ],
      "metadata": {
        "id": "N5ghxQESc7PV"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# Extract the 4 idler raw‐data slices between filtered drums\n",
        "# Build filtered_times from valid mask\n",
        "times = df_edges['Time'].values\n",
        "filtered_times = []\n",
        "for i, keep in enumerate(valid):\n",
        "    if keep:\n",
        "        filtered_times += [times[2*i], times[2*i+1]]\n",
        "\n",
        "# Define idler windows at odd→even drum boundaries\n",
        "window_indices = [1, 5, 9, 13]\n",
        "idler_windows = [(filtered_times[i], filtered_times[i+1]) for i in window_indices]\n",
        "\n",
        "# Slice each idler into its own DataFrame\n",
        "rotation_1_df = df_104[(df_104['Time'] >= idler_windows[0][0]) & (df_104['Time'] <= idler_windows[0][1])].copy()\n",
        "rotation_2_df = df_104[(df_104['Time'] >= idler_windows[1][0]) & (df_104['Time'] <= idler_windows[1][1])].copy()\n",
        "rotation_3_df = df_104[(df_104['Time'] >= idler_windows[2][0]) & (df_104['Time'] <= idler_windows[2][1])].copy()\n",
        "rotation_4_df = df_104[(df_104['Time'] >= idler_windows[3][0]) & (df_104['Time'] <= idler_windows[3][1])].copy()\n",
        "\n",
        "# Plot each idler (sum > 2)\n",
        "for idx, idler_df in enumerate(\n",
        "    [rotation_1_df, rotation_2_df, rotation_3_df, rotation_4_df], start=1\n",
        "):\n",
        "    df_plot = idler_df[idler_df['sum'] >= 2]\n",
        "    fig = px.line(\n",
        "        df_plot,\n",
        "        x='Time',\n",
        "        y='sum',\n",
        "        title=f'Idler data of rotation {idx}: Sensor Sum over Time (sum >= 2)'\n",
        "    )\n",
        "    fig.update_layout(xaxis_title='Time (s)', yaxis_title='Sensor Sum')\n",
        "    fig.show()"
      ],
