      "source": [
        "**Identification of Drums**\n",
        "\n",
        "*   Using time.diff\n",
        "*   additional filter i.e <11 to filter out idlers noise during drum detection."
      ],
      "metadata": {
        "id": "apG77uwdaRWK"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "from datetime import timedelta\n",
        "import plotly.express as px\n",
        "import numpy as np\n",
        "\n",
        "alicon_2020_C_103_speed = 0.364 #m/s\n",
        "alicon_2020_C_104_speed = 1.092 #m/s\n",
        "alicon_2020_C_6_speed = 0.182   #m/s\n",
        "\n",
        "raw_sensor_order = [0, 6, 1, 7, 2, 8, 3, 9, 4, 10, 5, 11]  # MATLAB column permutation to physical order\n",
        "\n",
        "raw_column_names = [\n",
        "    'Timestamp',\n",
        "    'Raw_0',\n",
        "    'Raw_1',\n",
        "    'Raw_2',\n",
        "    'Raw_3',\n",
        "    'Raw_4',\n",
        "    'Raw_5',\n",
        "    'Raw_6',\n",
        "    'Raw_7',\n",
        "    'Raw_8',\n",
        "    'Raw_9',\n",
        "    'Raw_10',\n",
        "    'Raw_11',\n",
        "]\n",
        "\n",
        "sensor_column_names = [\n",
        "    'Timestamp',\n",
        "    'Sensor_0',\n",
        "    'Sensor_1',\n",
        "    'Sensor_2',\n",
        "    'Sensor_3',\n",
        "    'Sensor_4',\n",
        "    'Sensor_5',\n",
        "    'Sensor_6',\n",
        "    'Sensor_7',\n",
        "    'Sensor_8',\n",
        "    'Sensor_9',\n",
        "    'Sensor_10',\n",
        "    'Sensor_11',\n",
        "]\n",
        "\n",
        "raw_sensor_columns = raw_column_names[1:]\n",
        "\n",
        "def load_and_align_dataset(path):\n",
        "    """Load raw CSV output and reorder sensors to match MATLAB helper mapping."""\n",
        "    df_raw = pd.read_csv(path, header=None, names=raw_column_names)\n",
        "    sensor_data = df_raw[[raw_sensor_columns[index] for index in raw_sensor_order]].copy()\n",
        "    sensor_data.columns = sensor_column_names[1:]\n",
        "    return df_raw[['Timestamp']].join(sensor_data)\n",
        "\n",
        "df_103 = load_and_align_dataset('./alicon_2020_C_103.csv')\n",
        "df_104 = load_and_align_dataset('./alicon_2020_C_104.csv')\n",
        "df_6   = load_and_align_dataset('./alicon_2020_C_6.csv')\n",
        "\n",
        "dfs    = [df_103, df_104, df_6]\n",
        "names  = ['df_103', 'df_104', 'df_6']\n",
        "speeds = [alicon_2020_C_103_speed, alicon_2020_C_104_speed, alicon_2020_C_6_speed]\n",
        "\n",
        "fractioning = 1_000_000  # Converts microseconds to seconds\n",
        "\n",
        "# Compute sum and normalize Time\n",
        "for df in [df_103, df_104, df_6]:\n",
        "    df['sum']  = df.drop(columns=['Timestamp']).sum(axis=1)\n",
        "    df['Time'] = (df['Timestamp'] - df['Timestamp'].iloc[0]) / fractioning\n",
        "\n",
        "# Plot raw sum vs Time and print total times/distances\n",
        "for name, df, speed in zip(names, dfs, speeds):\n",
        "    total_time     = df['Time'].max()\n",
        "    total_distance = total_time * speed\n",
        "\n",
        "    print(f\"\\n{name}\")\n",
        "    print(f\"Total time: {total_time:.2f} seconds\")\n",
        "    print(f\"Total distance: {total_distance:.2f} meters\")\n",
        "\n",
        "    fig = px.line(df, x='Time', y='sum', title=f'Sum over Time for {name}')\n",
        "    fig.update_layout(xaxis_title='Time (s)', yaxis_title='Sensor Sum')\n",
        "    fig.show()\n",
        "\n",
        "# Initial drum detection (sum ≥ 8)\n",
        "drum_det_103 = df_103[df_103['sum'] >= 8].copy(deep=True)\n",
        "drum_det_104 = df_104[df_104['sum'] >= 8].copy(deep=True)\n",
        "drum_det_6   = df_6[df_6['sum']   >= 8].copy(deep=True)\n",
        "\n",
        "print(\"Drum Detected DataFrames (sum ≥ 8):\")\n",
        "for name, df in zip(['drum_det_103','drum_det_104','drum_det_6'], [drum_det_103, drum_det_104, drum_det_6]):\n",
        "    fig = px.line(df, x='Time', y='sum', title=f'Sum over Time for {name}')\n",
        "    fig.update_layout(xaxis_title='Time', yaxis_title='Sum')\n",
        "    fig.show()\n",
        "\n",
        "# Compute time_diff & inspect outlier gaps\n",
        "for df in [drum_det_103, drum_det_104, drum_det_6]:\n",
        "    df['time_diff'] = df['Time'].diff().fillna(0)\n",
        "    outliers = df[df['time_diff'] > df['time_diff'].quantile(0.999)]\n",
        "    print(outliers)\n",
        "\n",
        "# Detailed segmentation for df_104\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import plotly.express as px\n",
        "\n",
        "# df_104 drum-detected set\n",
        "df = drum_det_104.copy(deep=True)\n",
        "Speed = alicon_2020_C_104_speed\n",
        "\n",
        "# Compute time differences\n",
        "df['time_diff'] = df['Time'].diff().fillna(0)\n",
        "\n",
        "# Reset index to make slicing consistent\n",
        "df = df.reset_index(drop=True)\n",
        "\n",
        "# Physical parameters\n",
        "drum_diameter   = 0.4   # m\n",
        "buffer_factor   = 1.2\n",
        "contact_distance= 0.5 * np.pi * drum_diameter * buffer_factor  # m\n",
        "\n",
        "# Calculate dynamic threshold\n",
        "time_threshold  = contact_distance / Speed\n",
        "print(f\"Time Threshold: {time_threshold:.2f} s\")\n",
        "\n",
        "# Detect segment break indices where time_diff > threshold, indicating a break\n",
        "index_default_1 = df[df['time_diff'] > time_threshold].index\n",
        "index_minus_1   = index_default_1 - 1\n",
        "\n",
        "# Build edges DataFrame\n",
        "df_edges = pd.concat([\n",
        "    pd.DataFrame(df.iloc[0]).T, # Start of the first segment\n",
        "    df.loc[index_minus_1.tolist() + index_default_1.tolist()].sort_index(), # Detected edges\n",
        "    pd.DataFrame(df.iloc[-1]).T # End of the last segment\n",
        "]).reset_index(drop=True)\n",
        "\n",
        "# Compute duration between edges\n",
        "df_edge = df_edges['Time'].diff().reset_index(drop=True).reset_index()\n",
        "\n",
        "# compute interaction lengths\n",
        "df_edge['interaction_length'] = df_edge['Time'] * Speed\n",
        "\n",
        "# Extract only actual drum segments (odd rows)\n",
        "drum_segments = df_edge[df_edge.index % 2 == 1].copy()\n",
        "\n",
        "# Label drums\n",
        "drum_segments['drum_label'] = ['Drum ' + str(i+1) for i in range(len(drum_segments))]\n",
        "\n",
        "# Display segment durations\n",
        "print(\"Detected Drum Segments:\")\n",
        "display(drum_segments[['drum_label', 'Time', 'interaction_length']])\n",
        "\n",
        "# Visualize drum segment durations\n",
        "px.bar(drum_segments, x='drum_label', y='Time', title='Duration of Detected Drum Segments for df_104').show()\n",
        "\n",
        "# Post-segmentation “sum ≥ 10” check to remove idler segments\n",
        "times = df_edges['Time'].values\n",
        "valid = []\n",
        "for i in range(len(drum_segments)):\n",
        "    start_time = times[2*i]      # even index in edges\n",
        "    end_time   = times[2*i + 1]  # odd index in edges\n",
        "    block = df[(df['Time'] >= start_time) & (df['Time'] <= end_time)]\n",
        "    valid.append(block['sum'].max() >= 11)\n",
        "\n",
        "# Filter out invalid (idler) segments\n",
        "drum_segments = drum_segments[valid].reset_index(drop=True)\n",
        "\n",
        "# relabel drums\n",
        "drum_segments['drum_label'] = ['Drum ' + str(i+1) for i in range(len(drum_segments))]\n",
        "\n",
        "# Display and plot final segments\n",
        "print(\"Filtered Detected Drum Segments\")\n",
        "display(drum_segments[['drum_label', 'Time', 'interaction_length']])\n",
        "\n",
        "px.bar(drum_segments, x='drum_label', y='interaction_length',\n",
        "       title='Filtered Drum Interaction Lengths for df_104').show()\n",
        "px.bar(drum_segments, x='drum_label', y='Time',\n",
        "       title='Filtered Drum Durations for df_104').show()\n"
      ],
