      "cell_type": "markdown",
      "source": [
        "**Idlers Identification**"
      ],
      "metadata": {
        "id": "z_KSFpnvekDW"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "\n",
        "# rotation_2_df\n",
        "\n",
        "# Filter to only rows where the idler is actually contacting\n",
        "df_idler = rotation_2_df[rotation_2_df['sum'] > 2].copy().reset_index(drop=True)\n",
        "\n",
        "# Compute time gaps between consecutive rows\n",
        "df_idler['time_diff'] = df_idler['Time'].diff().fillna(0)\n",
        "\n",
        "# Derive the time threshold from 0.15 m of interaction region\n",
        "threshold = 0.15 / Speed\n",
        "print(f\"Idler time threshold (0.15 m max interaction): {threshold:.3f} s\")\n",
        "\n",
        "# Find indices where the gap exceeds this threshold\n",
        "idx_after  = df_idler[df_idler['time_diff'] > threshold].index\n",
        "idx_before = idx_after - 1\n",
        "\n",
        "# Build the edges DataFrame marking start/end of each idler contact\n",
        "df_edges = pd.concat([\n",
        "    pd.DataFrame(df_idler.iloc[0]).T,\n",
        "    df_idler.loc[idx_before.tolist() + idx_after.tolist()].sort_index(),\n",
        "    pd.DataFrame(df_idler.iloc[-1]).T\n",
        "]).reset_index(drop=True)\n",
        "\n",
        "# Compute durations between those edges\n",
        "df_edge = df_edges['Time'].diff().reset_index(drop=True).reset_index()\n",
        "\n",
        "# Extract only the actual idler segments (odd rows)\n",
        "idler_segments = df_edge[df_edge.index % 2 == 1].copy()\n",
        "idler_segments['IdlerStation'] = [\n",
        "    f'IdlerStation {i+1}' for i in range(len(idler_segments))\n",
        "]\n",
        "\n",
        "# Graph BEFORE removal ---\n",
        "print(\"Before removal of drum‐noise segments:\")\n",
        "display(idler_segments[['IdlerStation','Time']])\n",
        "\n",
        "fig_before = px.bar(\n",
        "    idler_segments,\n",
        "    x='IdlerStation',\n",
        "    y='Time',\n",
        "    title='IdlerStation Durations (Before Noise Removal)',\n",
        "    labels={'Time':'Duration (s)', 'IdlerStation':'Station'}\n",
        ")\n",
        "fig_before.update_layout(xaxis_title='Idler Station', yaxis_title='Duration (s)')\n",
        "fig_before.show()\n",
        "\n",
        "# Remove first & last (these are drums, not idlers) ---\n",
        "filtered = idler_segments.iloc[1:-1].reset_index(drop=True)\n",
        "filtered['IdlerStation'] = [\n",
        "    f'IdlerStation {i+1}' for i in range(len(filtered))\n",
        "]\n",
        "\n",
        "# Graph AFTER removal ---\n",
        "print(\"After removal of drum‐noise segments:\")\n",
        "display(filtered[['IdlerStation','Time']])\n",
        "\n",
        "fig_after = px.bar(\n",
        "    filtered,\n",
        "    x='IdlerStation',\n",
        "    y='Time',\n",
        "    title='IdlerStation Durations (After Noise Removal)',\n",
        "    labels={'Time':'Duration (s)', 'IdlerStation':'Station'}\n",
        ")\n",
        "fig_after.update_layout(xaxis_title='Idler Station', yaxis_title='Duration (s)')\n",
        "fig_after.show()\n",
        "\n",
        "\n",
        "# To process all four datasets\n",
        "\n",
        "def process_idler(df, name):\n",
        "\n",
        "    # Filter to only rows where the idler is actually contacting\n",
        "    df_id = df[df['sum'] > 2].copy().reset_index(drop=True)\n",
        "\n",
        "    # Compute time gaps between consecutive rows\n",
        "    df_id['time_diff'] = df_id['Time'].diff().fillna(0)\n",
        "\n",
        "    # Derive the time threshold\n",
        "    thresh = 0.15 / Speed\n",
        "\n",
        "    # Find indices where the gap exceeds this threshold\n",
        "    after_idx  = df_id[df_id['time_diff'] > thresh].index\n",
        "    before_idx = after_idx - 1\n",
        "\n",
        "    # Build the edges DataFrame\n",
        "    edges = pd.concat([\n",
        "        pd.DataFrame(df_id.iloc[0]).T,\n",
        "        df_id.loc[before_idx.tolist() + after_idx.tolist()].sort_index(),\n",
        "        pd.DataFrame(df_id.iloc[-1]).T\n",
        "    ]).reset_index(drop=True)\n",
        "\n",
        "    # Compute durations between those edges\n",
        "    edge_dur = edges['Time'].diff().reset_index(drop=True).reset_index()\n",
        "\n",
        "    # Extract only the actual idler segments (odd rows)\n",
        "    segments = edge_dur[edge_dur.index % 2 == 1].copy()\n",
        "\n",
        "    # assign a simple station number\n",
        "    segments['Station'] = [i+1 for i in range(len(segments))]\n",
        "\n",
        "    # compute interaction length = duration * speed\n",
        "    segments['Length'] = segments['Time'] * Speed\n",
        "\n",
        "    # Remove drum-noise segments (first & last)\n",
        "    segments = segments.iloc[1:-1].reset_index(drop=True)\n",
        "\n",
        "    # re-assign station number after removal\n",
        "    segments['Station'] = [i+1 for i in range(len(segments))]\n",
        "\n",
        "    # label dataset\n",
        "    segments['Dataset'] = name\n",
        "    return segments[['Dataset','Station','Time','Length']]\n",
        "\n",
        "# Dict of your four dataframes, renamed\n",
        "datasets = {\n",
        "    'rotation_1': rotation_1_df,\n",
        "    'rotation_2': rotation_2_df,\n",
        "    'rotation_3': rotation_3_df,\n",
        "    'rotation_4': rotation_4_df,\n",
        "}\n",
        "\n",
        "# Process each and combine\n",
        "all_segs = [process_idler(df, name) for name, df in datasets.items()]\n",
        "summary_long = pd.concat(all_segs, ignore_index=True)\n",
        "\n",
        "# Pivot into wide form\n",
        "summary_wide = summary_long.pivot(index='Station',\n",
        "                                  columns='Dataset',\n",
        "                                  values=['Time','Length'])\n",
        "\n",
        "# Flatten multi-index columns\n",
        "summary_wide.columns = [f\"{dataset}_{metric}\" for metric, dataset in summary_wide.columns]\n",
        "\n",
        "# Keep only first 26 stations\n",
        "summary_wide = summary_wide.iloc[:26]\n",
        "\n",
        "# Reset index to make 'Station' a column\n",
        "summary_wide.reset_index(inplace=True)\n",
        "\n",
        "# Reorder columns so that for each dataset, Time and Length are adjacent\n",
        "ordered_cols = ['Station']\n",
        "for ds in datasets.keys():\n",
        "    ordered_cols += [f\"{ds}_Time\", f\"{ds}_Length\"]\n",
        "summary_wide = summary_wide[ordered_cols]\n",
        "\n",
        "# Display the final comparison table\n",
        "print(\"Comparison of interaction time and length (adjacent columns) for the first 26 idler stations:\")\n",
        "display(summary_wide)\n"
      ],
